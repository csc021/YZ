<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tf.sc.mapper.ParcelMapper">

    <!-- 多条件查询包裹：运单号、收件人、驿站、快递员、状态 -->
    <select id="selectParcelCondition" resultType="com.tf.sc.entity.Parcel">
        SELECT * FROM parcel
        <where>
            <if test="trackingNo != null and trackingNo != ''">
                tracking_no LIKE CONCAT('%',#{trackingNo},'%')
            </if>
            <if test="recipientPhone != null and recipientPhone != ''">
                AND recipient_phone = #{recipientPhone}
            </if>
            <if test="stationId != null">
                AND station_id = #{stationId}
            </if>
            <if test="carrierId != null">
                AND carrier_id = #{carrierId}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <!-- 批量更新包裹状态 -->
    <update id="batchUpdateStatus">
        UPDATE parcel SET status = #{status}
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
