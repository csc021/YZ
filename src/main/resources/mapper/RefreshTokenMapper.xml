<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tf.sc.mapper.RefreshTokenMapper">
    <resultMap id="BaseResultMap" type="com.tf.sc.entity.RefreshToken">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="token" property="token"/>
        <result column="expire_time" property="expireTime"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 根据用户ID查询有效令牌 -->
    <select id="selectValidTokenByUserId" resultMap="BaseResultMap">
        SELECT * FROM refresh_token
        WHERE user_id = #{userId} AND expire_time &gt; NOW()
    </select>

    <!-- 批量注销用户所有令牌（退出登录/改密码） -->
    <delete id="deleteAllTokenByUserId">
        DELETE FROM refresh_token WHERE user_id = #{userId}
    </delete>

    <!-- 清理过期token -->
    <delete id="deleteExpiredToken">
        DELETE FROM refresh_token WHERE expire_time &lt; NOW()
    </delete>
</mapper>
