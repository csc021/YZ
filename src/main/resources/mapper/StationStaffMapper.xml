<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tf.sc.mapper.StationStaffMapper">

    <resultMap id="BaseResultMap" type="com.tf.sc.entity.StationStaff">
        <id column="id" property="id"/>
        <result column="station_id" property="stationId"/>
        <result column="user_id" property="userId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 插入 -->
    <insert id="insert" parameterType="com.tf.sc.entity.StationStaff" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO station_staff (station_id, user_id, created_at)
        VALUES (#{stationId}, #{userId}, #{createdAt})
    </insert>

    <!-- 根据ID删除 -->
    <delete id="deleteById">
        DELETE FROM station_staff WHERE id = #{id}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM station_staff WHERE user_id = #{userId}
    </delete>

    <!-- 根据驿站ID查询所有员工 -->
    <select id="findByStationId" resultMap="BaseResultMap">
        SELECT * FROM station_staff WHERE station_id = #{stationId}
        ORDER BY created_at DESC
    </select>

    <!-- 根据用户ID查询所属驿站 -->
    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT * FROM station_staff WHERE user_id = #{userId}
    </select>

    <!-- 根据驿站ID和用户ID查询 -->
    <select id="findByStationAndUser" resultMap="BaseResultMap">
        SELECT * FROM station_staff WHERE station_id = #{stationId} AND user_id = #{userId}
    </select>

    <!-- 查询某个驿站的所有员工ID列表 -->
    <select id="findUserIdsByStationId" resultType="java.lang.Long">
        SELECT user_id FROM station_staff WHERE station_id = #{stationId}
    </select>

</mapper>
